{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SwartzMss/agent-wiki/blob/main/schemas/evidence.schema.json",
  "title": "Agent Wiki Evidence Record",
  "description": "A compact claim with source locators and content fingerprints. Source text is not stored.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "claim", "classification", "scope", "sources", "created_at"],
  "properties": {
    "id": { "type": "string", "minLength": 8 },
    "claim": { "type": "string", "minLength": 1, "maxLength": 1200 },
    "classification": {
      "type": "string",
      "enum": ["verified_fact", "verified_convention", "historical_fact", "potential_discrepancy", "unverified_hypothesis"]
    },
    "scope": { "type": "string", "maxLength": 500 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "symbol", "start_line", "end_line"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "symbol": { "type": ["string", "null"], "maxLength": 300 },
          "start_line": { "type": ["integer", "null"], "minimum": 1 },
          "end_line": { "type": ["integer", "null"], "minimum": 1 }
        }
      }
    },
    "notes": { "type": "string", "maxLength": 1000 },
    "created_at": { "type": "string", "format": "date-time" },
    "reused_from_session_id": { "type": ["string", "null"] }
  }
}
